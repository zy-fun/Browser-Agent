# Select openai or deepseek. Defaults to openai when omitted.
LLM_PROVIDER=openai
LLM_MODEL=

# OpenAI Responses API configuration
OPENAI_API_KEY=
OPENAI_MODEL=

# DeepSeek OpenAI-compatible API configuration
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Absolute file:// URL or HTTP URL of a MiniWoB++ checkout.
MINIWOB_URL=
